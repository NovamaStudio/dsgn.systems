    <!-- Scale: a real dsgn button measured live. main.js steps it through the densities and draws
         its line height and padding as dimension lines; the table holds the measured values. -->
    <section class="dsgn-section sheet-section" id="scale" aria-labelledby="scale-title">
      <div class="dsgn-container">
        <div class="sheet">
          <div class="sheet-cell sheet-head" data-tone="sunken">
            <div class="sheet-head-text">
              <p class="sheet-meta sheet-key">The scale</p>
              <h2 class="dsgn-display" id="scale-title">Sizes come from type.</h2>
              <p class="dsgn-body">A control is its line of text plus padding from the spacing scale, snapped to a 2&nbsp;px grid at any browser font size. Density sets the padding, and L opens up the line for touch.</p>
            </div>
          </div>
          <figure class="sheet-cell anatomy-cell" data-span="half">
            <figcaption class="sheet-meta"><span class="sheet-key">Button</span> <span id="anatomy-label">density M</span></figcaption>
            <div class="anatomy" id="anatomy" data-density="m" aria-hidden="true">
              <span class="anatomy-line" data-edge="top"></span>
              <span class="anatomy-line" data-edge="text-top"></span>
              <span class="anatomy-line" data-edge="text-bottom"></span>
              <span class="anatomy-line" data-edge="bottom"></span>
              <span class="anatomy-value" data-part="pad-top"></span>
              <span class="anatomy-value" data-part="line"></span>
              <span class="anatomy-value" data-part="pad-bottom"></span>
              <span class="anatomy-value" data-part="height"></span>
              <span class="dsgn-button anatomy-button">Send reminder</span>
            </div>
          </figure>
          <div class="sheet-cell sheet-flush" data-span="half">
            <table class="log" id="anatomy-table">
              <caption class="dsgn-visually-hidden">Button height in each density, measured in this page</caption>
              <thead><tr><th scope="col">Density</th><th scope="col" data-numeric>Text</th><th scope="col" data-numeric>Padding</th><th scope="col" data-numeric>Height</th></tr></thead>
              <tbody>
                <tr data-density="s"><th scope="row">S</th><td data-numeric>–</td><td data-numeric>–</td><td data-numeric>–</td></tr>
                <tr data-density="m"><th scope="row">M</th><td data-numeric>–</td><td data-numeric>–</td><td data-numeric>–</td></tr>
                <tr data-density="l"><th scope="row">L <span class="log-note">touch</span></th><td data-numeric>–</td><td data-numeric>–</td><td data-numeric>–</td></tr>
              </tbody>
            </table>
            <p class="log-foot">Height = text + 2 × padding, in px at this font size. Touch screens without a density set use L.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Modes: one card, one attribute at a time. main.js changes the attributes in turn and marks the
         current value in the log; the pause button stops it (WCAG 2.2.2). -->
    <section class="dsgn-section sheet-section" id="modes" aria-labelledby="modes-title">
      <div class="dsgn-container">
        <div class="sheet">
          <div class="sheet-cell sheet-head" data-tone="sunken">
            <div class="sheet-head-text">
              <p class="sheet-meta sheet-key">Modes</p>
              <h2 class="dsgn-display" id="modes-title">Every mode is one attribute.</h2>
              <p class="dsgn-body">Light or dark, dense or roomy, square or pill. Set it on <code>&lt;html&gt;</code> for the whole page or on any section; the markup stays the same.</p>
            </div>
          </div>
          <div class="sheet-cell sheet-flush modes-log-cell" data-span="half">
