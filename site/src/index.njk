                <tr data-attr="density"><th scope="row">data-density</th><td><span data-value="s">s</span> <span data-value="m">m</span> <span data-value="l">l</span></td></tr>
                <tr data-attr="radius"><th scope="row">data-radius</th><td><span data-value="sharp">sharp</span> <span data-value="default">default</span> <span data-value="rounded">rounded</span> <span data-value="pill">pill</span></td></tr>
                <tr data-attr="elevation"><th scope="row">data-elevation</th><td><span data-value="flat">flat</span> <span data-value="soft">soft</span></td></tr>
