<!doctype html>
<html lang="{{ lang or site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ metaTitle or title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta name="theme-color" content="{{ site.themeColor }}">

  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ metaTitle or title }}">
  <meta property="og:description" content="{{ ogDescription or description }}">
  <meta property="og:image" content="{{ site.url }}/img/og.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;700&display=swap">
  {#- icon_names is filled in after rendering with every icon the page uses (see eleventy.config.mjs). #}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=@ICONS&display=block">

  <link rel="stylesheet" href="/vendor/dsgn/dsgn.css">
  <link rel="stylesheet" href="/dsgn.theme.css">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/logo-motion.css">
  <script src="/vendor/dsgn/dsgn.js" defer></script>
  <script src="/main.js" defer></script>
{#- Extra head markup for one page: `head: partials/….njk` in its front matter. #}
{% if head %}{% include head %}{% endif %}
</head>
<body class="dsgn-page">
  <a class="dsgn-button dsgn-skip-link" href="#main">Skip to content</a>

  {% include "svg/sprite.svg" %}

{% include "partials/header.njk" %}

  <main id="main">
{{ content | safe }}
  </main>

{% include "partials/footer.njk" %}
</body>
</html>
