{%- if footerSheet %}
  {#- Home: the footer is the last band of the page sheet (same rules and grid as the sections). #}
  <footer class="site-foot">
    <div class="dsgn-container">
      <div class="sheet">
        {%- if footerFaq %}{% include "partials/home-faq.njk" %}{% else %}
        <div class="sheet-cell sheet-stack" data-span="half">
          <a class="dsgn-brand site-brand" href="/" aria-label="dsgn.systems, home">
            <svg class="site-wordmark" aria-hidden="true" focusable="false"><use href="#dsgn-wordmark"></use></svg>
          </a>
          <p class="dsgn-body-s dsgn-muted">Token-driven CSS design system, mirrored 1:1 in Figma.</p>
        </div>
        {%- endif %}
        <nav class="sheet-cell sheet-stack" data-span="quarter" aria-labelledby="foot-learn">
          <h2 class="sheet-meta sheet-key" id="foot-learn">Learn</h2>
          <ul class="dsgn-footer-links">
            <li><a href="{{ site.links.docs }}">Documentation</a></li>
            <li><a href="{{ site.links.themeCustomizer }}">Theme customizer</a></li>
            <li><a href="{{ site.links.showcase }}">Showcase</a></li>
            <li><a href="{{ site.links.changelog }}">Changelog</a></li>
          </ul>
        </nav>
        <nav class="sheet-cell sheet-stack" data-span="quarter" aria-labelledby="foot-code">
          <h2 class="sheet-meta sheet-key" id="foot-code">Code</h2>
          <ul class="dsgn-footer-links">
            <li><a href="{{ site.links.repo }}">GitHub</a></li>
            <li><a href="{{ site.links.npm }}">npm</a></li>
            {% if site.links.figmaFile %}<li><a href="{{ site.links.figmaFile }}">Figma library</a></li>{% endif %}
            <li><a href="{{ site.links.figmaPlugin }}">Figma theme plugin</a></li>
            <li><a href="{{ site.links.skill }}">Skill for AI agents</a></li>
          </ul>
        </nav>
        {%- if footerFaq %}
        {#- the brand moves to the last row, beside the copyright #}
        <div class="sheet-cell sheet-stack site-foot-brand" data-span="half">
          <a class="dsgn-brand site-brand" href="/" aria-label="dsgn.systems, home">
            <svg class="site-wordmark" aria-hidden="true" focusable="false"><use href="#dsgn-wordmark"></use></svg>
          </a>
          <p class="dsgn-body-s dsgn-muted">Token-driven CSS design system, mirrored 1:1 in Figma.</p>
        </div>
        <p class="sheet-cell sheet-meta site-foot-meta" data-span="quarter"><span class="sheet-key">©</span>{{ site.year }} {{ site.org }}</p>
        <p class="sheet-cell sheet-meta site-foot-meta" data-span="quarter"><span class="sheet-key">Licence</span><a href="{{ site.links.license }}">MIT</a></p>
        {%- else %}
        <p class="sheet-cell sheet-meta" data-span="half" data-tone="sunken"><span class="sheet-key">©</span>{{ site.year }} {{ site.org }}</p>
        <p class="sheet-cell sheet-meta" data-span="half" data-tone="sunken"><span class="sheet-key">Licence</span><a href="{{ site.links.license }}">MIT</a></p>
        {%- endif %}
      </div>
    </div>
  </footer>
{%- else %}
  <footer class="dsgn-footer">
    <div class="dsgn-container dsgn-stack" data-gap="xl">
      <div class="dsgn-footer-top">
        <div class="dsgn-footer-brand dsgn-stack" data-gap="s">
          <a class="dsgn-brand site-brand" href="/" aria-label="dsgn.systems, home">
            <svg class="site-wordmark" aria-hidden="true" focusable="false"><use href="#dsgn-wordmark"></use></svg>
          </a>
          <p class="dsgn-body-s dsgn-muted">Token-driven CSS design system, mirrored 1:1 in Figma.</p>
        </div>
        <div class="dsgn-footer-columns">
          <div>
            <h2 class="dsgn-footer-title">Learn</h2>
            <ul class="dsgn-footer-links">
              <li><a href="{{ site.links.docs }}">Documentation</a></li>
              <li><a href="{{ site.links.themeCustomizer }}">Theme customizer</a></li>
              <li><a href="{{ site.links.showcase }}">Showcase</a></li>
              <li><a href="{{ site.links.changelog }}">Changelog</a></li>
            </ul>
          </div>
          <div>
            <h2 class="dsgn-footer-title">Code</h2>
            <ul class="dsgn-footer-links">
              <li><a href="{{ site.links.repo }}">GitHub</a></li>
              <li><a href="{{ site.links.npm }}">npm</a></li>
              {% if site.links.figmaFile %}<li><a href="{{ site.links.figmaFile }}">Figma library</a></li>{% endif %}
            <li><a href="{{ site.links.figmaPlugin }}">Figma theme plugin</a></li>
              <li><a href="{{ site.links.skill }}">Skill for AI agents</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="dsgn-cluster dsgn-footer-legal" data-justify="between">
        <p>© {{ site.year }} {{ site.org }}</p>
        <p>Released under the <a href="{{ site.links.license }}">MIT licence</a></p>
      </div>
    </div>
  </footer>
{%- endif %}
